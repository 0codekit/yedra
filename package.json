{
	"name": "yedra",
	"version": "0.21.2",
	"repository": "github:0codekit/yedra",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		}
	},
	"sideEffects": false,
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^26.2.0",
		"@types/ws": "^8.18.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"bugs": "https://github.com/0codekit/yedra/issues",
	"contributors": [
		"Justus Zorn <jzorn@wemakefuture.com>"
	],
	"description": "A TypeScript web framework with OpenAPI generation.",
	"keywords": [
		"typescript",
		"web",
		"http",
		"schema",
		"validation",
		"openapi",
		"standard-schema"
	],
	"license": "MIT",
	"files": [
		"./dist/**",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22.15"
	},
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check src",
		"format": "biome check --write src",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build"
	},
	"type": "module",
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@standard-schema/spec": "^1.1.0",
		"mime": "^4.1.0",
		"ws": "^8.21.3"
	}
}
