{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"linter": {
		"rules": {
			"recommended": true,
			"suspicious": {
				"noShadow": "error",
				"noForIn": "error"
			},
			"style": {
				"useConsistentMemberAccessibility": {
					"level": "error",
					"options": {
						"accessibility": "explicit"
					}
				},
				"useReadonlyClassProperties": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"indentStyle": "space",
			"indentWidth": 2,
			"quoteStyle": "single"
		}
	}
}
